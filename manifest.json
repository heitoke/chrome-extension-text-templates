{
  "manifest_version": 3,
  "name": "Text Templates",
  "version": "1.0",
  "description": "Создание шаблонов для текста и использования их.",
  "permissions": [
    "activeTab", 
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Text Templates - Options"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon96.png"
  }
}